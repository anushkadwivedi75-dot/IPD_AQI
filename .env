# ===============================================
# AirSentinel (IPD_AQI) Docker Environment Config
# ===============================================

# PostGIS Spatial Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airsentine1
POSTGRES_PORT=5433

# FastAPI Backend Configuration
PROJECT_NAME=AirSentine1 API
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/airsentine1

# Flutter Web Frontend Configuration
FRONTEND_PORT=3000
# Leave API_BASE_URL blank to use automatic Nginx /api reverse proxying,
# or set to an explicit URL (e.g. http://localhost:8000) if needed.
API_BASE_URL=
